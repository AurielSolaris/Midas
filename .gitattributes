# Normalize text in the repository and use native line endings by default.
* text=auto

# Shell scripts need LF; Windows command scripts use CRLF.
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Source and configuration files are portable text.
*.kt text
*.kts text
*.gradle text
*.toml text
*.properties text
*.xml text
*.json text
*.md text
*.MD text
*.py text
*.svg text

# Binary assets and packaged native dependencies must never be normalized.
*.jar binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
*.msi binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.zst binary
